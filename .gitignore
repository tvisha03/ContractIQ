# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environment
# IMPORTANT: This assumes your venv folder is named .venv and is inside the backend folder
backend/.venv/

# Database
# Never commit your local database files
*.sqlite3
*.db

# ML Models
# Model files can be large and should be generated, not tracked
*.joblib
*.h5
*.pkl

# OS-generated files
.DS_Store
Thumbs.db

# Environment variables
# The .env file contains secrets and should NEVER be committed
.env
.env.example

# Node / Frontend dependencies
# This is standard for React/Vite projects
frontend/node_modules/
frontend/dist/
frontend/.pnp
frontend/.pnp.js